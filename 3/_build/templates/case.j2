{% extends "base.j2" %}
{% from "macros.j2" import case_card %}
{% block main %}
{%- set c = page.case %}
{%- set sv = page.svc_by_slug[c.service] %}

<article class="case" data-hero>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container case__grid">

    <!-- sidebar: адвокат -->
    <aside class="case__side">
      <div class="lawyer-card" data-hero-in>
        <div class="lawyer-card__photo"><img src="{{ page.root }}assets/img/lawyer-office.webp" alt="{{ _("Адвокат Сергій Мазур") }}" width="944" height="1025" loading="lazy"></div>
        <b class="lawyer-card__name">{{ _("Сергій Мазур") }}</b>
        <span class="lawyer-card__role">{{ _("Адвокат · Свідоцтво №") }} {{ site.cert }}</span>
        <div class="lawyer-card__contacts">
          <span>{{ _("Телефон") }}</span>
          <a href="tel:{{ site.phone_href }}">{{ site.phone }}</a>
          <span>E-mail</span>
          <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        </div>
        <p class="lawyer-card__text">{{ site.years }} {{ _("років практики. Справу веду особисто — без помічників і посередників.") }}</p>
        <button class="btn btn--gold btn--md btn--block" type="button" data-modal-open data-topic="{{ _("Безкоштовна консультація") }}">{{ _("Зв'язатися зараз") }}</button>
      </div>
    </aside>

    <!-- article -->
    <div class="case__body">
      <nav class="crumbs" aria-label="{{ _("Хлібні крихти") }}" data-hero-in>
        <a href="index.html">{{ _("Головна") }}</a><i class="ic ic-li-diamond ic-gold"></i>
        <a href="keysy.html">{{ _("Кейси") }}</a><i class="ic ic-li-diamond ic-gold"></i>
        <span>{{ sv.nav }}</span>
      </nav>
      <h1 class="case__title" data-chars>{{ _("Кейс:") }} {{ c.title }}</h1>
      <div class="case__meta" data-hero-in>
        <a class="badge" href="{{ sv.slug }}.html"><i class="ic ic-gold {{ sv.icon }}"></i>{{ sv.nav }}</a>
        <span class="badge badge--muted"><i class="ic ic-clock"></i>{{ _("Час прочитання:") }} {{ c.read }} {{ _("хв") }}</span>
        <span class="badge badge--muted">{{ c.date }}</span>
      </div>

      <div class="case__content">
        <p class="case__lead" data-reveal>{{ c.lead }}</p>
        <blockquote class="quote" data-reveal>{{ c.quote }}</blockquote>

        <h2 class="case__h2" data-reveal><span>01</span>{{ _("У чому полягала складність ситуації?") }}</h2>
        {%- for p in c.problem %}
        <p data-reveal>{{ p }}</p>
        {%- endfor %}

        <h2 class="case__h2" data-reveal><span>02</span>{{ _("Що було зроблено") }}</h2>
        <p data-reveal>{{ c.work_intro }}</p>
        <ol class="case__steps" data-reveal-group>
          {%- for w in c.work %}
          <li><span>{{ '%02d' % loop.index }}</span>{{ w }}</li>
          {%- endfor %}
        </ol>

        <h2 class="case__h2" data-reveal><span>03</span>{{ _("Результат") }}</h2>
        <div class="case__result" data-reveal>
          <i class="ic ic-gold ic-check-circle"></i>
          <div>
            {%- for p in c.result %}
            <p>{{ p }}</p>
            {%- endfor %}
          </div>
        </div>

        <p class="case__note" data-reveal>{{ _("Результат конкретної справи залежить від її обставин і не гарантує аналогічного рішення в інших випадках.") }}</p>

        <div class="case__cta" data-reveal>
          <div>
            <h2>{{ _("Схожа ситуація?") }}</h2>
            <p>{{ _("Опишіть її — проведу безкоштовну консультацію та запропоную план дій. Детальніше про послугу — на сторінці «") }}<a href="{{ sv.slug }}.html">{{ sv.nav }}</a>».</p>
          </div>
          <button class="btn btn--dark btn--lg" type="button" data-modal-open data-topic="{{ _("Безкоштовна консультація") }}">{{ _("Безкоштовна консультація") }}</button>
        </div>
      </div>
    </div>
  </div>
</article>

{%- if page.more_cases %}
<section class="section section--alt">
  <div class="container">
    <div class="sec-head sec-head--split">
      <div>
        <span class="eyebrow" data-reveal>{{ _("Кейси") }}</span>
        <h2 class="h2" data-split>{{ _("Інші") }} <span class="gold-text">{{ _("кейси") }}</span></h2>
      </div>
      <a class="btn btn--ghost btn--md" href="keysy.html" data-reveal>{{ _("Усі кейси") }} <i class="ic ic-gold ic-arrow-right"></i></a>
    </div>
    <div class="cases__list cases__list--3" data-reveal-group>
      {%- for oc in page.more_cases %}
      {{ case_card(oc, page.svc_by_slug[oc.service]) }}
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}
{% endblock %}
