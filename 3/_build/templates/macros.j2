{%- macro stars() -%}<span class="stars"><i class="ic ic-gold ic-star-fill"></i><i class="ic ic-gold ic-star-fill"></i><i class="ic ic-gold ic-star-fill"></i><i class="ic ic-gold ic-star-fill"></i><i class="ic ic-gold ic-star-fill"></i></span>{%- endmacro -%}

{%- macro review(v) -%}
    <article class="review">
      <div class="review__top">{{ stars() }}<span class="review__src">{{ v.get('src', 'Google') }}</span></div>
      <p class="review__text">{{ v.text }}</p>
      <div class="review__author"><span class="avatar">{{ v.initials }}</span><div><b>{{ v.name }}</b><span>{{ v.tag }}{% if v.date %} · {{ v.date }}{% endif %}</span></div></div>
    </article>
{%- endmacro -%}

{%- macro faq_item(f, open=false) -%}
      <div class="faq__item{% if open %} is-open{% endif %}">
        <button class="faq__q" type="button" aria-expanded="{{ 'true' if open else 'false' }}"><h3>{{ f.q }}</h3><span class="faq__icon"><i class="ic ic-gold ic-plus"></i></span></button>
        <div class="faq__a"><div><p>{{ f.a|safe }}</p></div></div>
      </div>
{%- endmacro -%}

{%- macro case_card(c, sv) -%}
      <a class="case-card" href="keys-{{ c.slug }}.html" data-cat="{{ c.service }}">
        <span class="case-card__top">
          <span class="case-card__icon"><i class="ic ic-gold {{ sv.icon }}"></i></span>
          <span class="case-card__cat">{{ sv.nav }}</span>
        </span>
        <span class="case-card__title">{{ c.title }}</span>
        <span class="case-card__result"><i class="ic ic-gold ic-check-circle"></i>{{ c.result_short }}</span>
        <span class="case-card__foot"><span>{{ c.date }}</span><span class="case-card__more">{{ _("Читати кейс") }} <i class="ic ic-arrow-right"></i></span></span>
      </a>
{%- endmacro -%}
